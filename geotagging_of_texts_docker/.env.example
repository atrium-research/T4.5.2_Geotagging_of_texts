# The OCR, reranker, embedding and NER models are fixed inside the image and cannot be changed here.

# Port on this computer; the app listens on the same port inside the container.
APP_PORT=8000
# Default compose profile: plain `docker compose up` runs on the CPU.
# `docker compose --profile gpu up` replaces it and runs on the GPU. Do not edit.
COMPOSE_PROFILES=cpu
# Network address the port is published on. Keep 127.0.0.1 unless a login proxy sits in front.
BIND_ADDR=127.0.0.1

# The LLM that writes the place descriptions: Hugging Face "owner/repo:quant" (GGUF).
# The default is already in the image. Any other value is downloaded on first start
# (into the geotagging-cache volume) and loaded before the app reports ready.
CHAT_MODEL=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M

# Keep uploaded files and results on disk between restarts (true), or only until the
# container stops, with runs older than an hour deleted automatically (false).
SAVE_RUNS=false

# Optional tuning.
# Context window (tokens) of each model server. Raise it if a run stops with
# "paragraph is too long for the model's context window", e.g. 8192 or 16384.
# Bigger values use more memory (roughly +150 MB per 1000 tokens for the default LLM). Restart after changing.
LLAMA_CONTEXT=4096
LLAMA_THREADS=0
MAX_UPLOAD_MB=50